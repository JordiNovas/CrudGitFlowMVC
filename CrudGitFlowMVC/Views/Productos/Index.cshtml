@model IEnumerable<CrudGitFlowMVC.Models.Producto>

<h1>Productos</h1>

<a asp-action="Create" class="btn btn-primary">
    Crear Producto
</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Descripción</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Precio</td>
                <td>@item.Cantidad</td>
                <td>@item.Descripcion</td>
            </tr>
        }

    </tbody>
</table>